[Unit]
Description=WallForge live wallpapers (session daemon)
Documentation=https://github.com/pgm1207/WallForge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wallforge --daemon
Restart=on-failure
RestartSec=3
KillMode=process

[Install]
WantedBy=graphical-session.target
